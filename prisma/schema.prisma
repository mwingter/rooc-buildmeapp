generator client {
  provider = "prisma-client-js"
}

enum GuildRole {
  LEADER
  MEMBER
}

enum GuildRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id              String                @id @default(cuid())
  name            String
  slug            String                @unique
  description     String?               @db.Text
  ownerId         String
  owner           User                  @relation("guildOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         GuildMember[]
  requests        GuildJoinRequest[]
  recommendations GuildRecommendation[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([ownerId, createdAt])
}

model GuildMember {
  guildId   String
  userId    String
  role      GuildRole @default(MEMBER)
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([guildId, userId])
  @@index([userId, role])
}

model GuildJoinRequest {
  id          String             @id @default(cuid())
  guildId     String
  requesterId String
  status      GuildRequestStatus @default(PENDING)
  guild       Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  requester   User               @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([guildId, requesterId])
  @@index([guildId, status])
}

model GuildRecommendation {
  guildId   String
  buildId   String
  addedById String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  build     Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  addedBy   User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([guildId, buildId])
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum BuildVisibility {
  PUBLIC
  PRIVATE
  FRIENDS
  GUILD
}

enum BuildContent {
  PVE
  PVP
  MVP
  WG
}

enum FriendStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?
  image                String?
  role                 Role                  @default(USER)
  gameNick             String?
  nickVerified         Boolean               @default(false)
  nickCode             String?
  nickCodeExpires      DateTime?
  deletedAt            DateTime?
  accounts             Account[]
  sessions             Session[]
  builds               Build[]
  comments             Comment[]
  favorites            Favorite[]
  likes                Like[]
  sentFriends          Friendship[]          @relation("sentFriend")
  receivedFriends      Friendship[]          @relation("receivedFriend")
  reports              Report[]              @relation("reports")
  auditLogs            AuditLog[]
  notifications        Notification[]
  ownedGuilds          Guild[]               @relation("guildOwner")
  guildMemberships     GuildMember[]
  guildRequests        GuildJoinRequest[]
  guildRecommendations GuildRecommendation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Build {
  id                   String                @id @default(cuid())
  authorId             String
  author               User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name                 String
  description          String                @db.Text
  classId              String
  class                GameClass             @relation(fields: [classId], references: [id])
  specialization       String
  role                 String
  content              BuildContent[]
  patchVersion         String
  visibility           BuildVisibility       @default(PUBLIC)
  official             Boolean               @default(false)
  attributes           Json
  skills               Json
  equipment            Json
  cards                Json
  runes                Json
  astrocore            Json
  mechanics            Json
  likes                Like[]
  favorites            Favorite[]
  comments             Comment[]
  reports              Report[]
  versions             BuildVersion[]
  guildRecommendations GuildRecommendation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([classId, visibility, createdAt])
}

model BuildVersion {
  id        String   @id @default(cuid())
  buildId   String
  build     Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  snapshot  Json
  note      String?
  createdAt DateTime @default(now())
}

model Comment {
  id        String    @id @default(cuid())
  buildId   String
  build     Build     @relation(fields: [buildId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("commentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("commentReplies")
  body      String    @db.Text
  hidden    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([buildId, createdAt])
}

model Like {
  userId  String
  buildId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@id([userId, buildId])
}

model Favorite {
  userId  String
  buildId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@id([userId, buildId])
}

model Friendship {
  id          String       @id @default(cuid())
  requesterId String
  recipientId String
  status      FriendStatus @default(PENDING)
  requester   User         @relation("sentFriend", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User         @relation("receivedFriend", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([requesterId, recipientId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("reports", fields: [reporterId], references: [id], onDelete: Cascade)
  buildId    String?
  build      Build?       @relation(fields: [buildId], references: [id], onDelete: SetNull)
  commentId  String?
  reason     String
  status     ReportStatus @default(OPEN)
  resolution String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model GameClass {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  specializations String[]
  iconUrl         String?
  license         String?
  builds          Build[]
}

model CatalogItem {
  id          String  @id @default(cuid())
  type        String
  name        String
  slug        String
  description String? @db.Text
  iconUrl     String?
  metadata    Json?
  license     String?

  @@unique([type, slug])
}
